---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import FeaturedProject from '../../components/FeaturedProject.astro';
import Skills from '../../components/Skills.astro';
import CallToAction from '../../components/CallToAction.astro';
import SkipLink from '../../components/SkipLink.astro';
import Scanlines from '../../components/Scanlines.astro';
import FullWidth from '../../components/FullWidth.astro';
import { useTranslations, getLocale, localizedHref } from '../../i18n';
import { getCollection } from 'astro:content';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const lang = locale === 'nl' ? 'nl' : 'en';

const skills = {
    backend: ['C#', '.NET', 'Java', 'PostgreSQL', 'Docker'],
    frontend: ['HTML5', 'CSS3', 'JavaScript', 'TypeScript', 'React', 'Vue.js', 'Tailwind CSS', 'SCSS', 'Astro'],
    tools: ['Git', 'JavaFX', 'Cisco', 'Raspberry Pi'],
};

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter(p => p.data.featured === true);
const pool = featuredProjects.length > 0 ? featuredProjects : allProjects;
const selectedProject = pool[Math.floor(Math.random() * pool.length)];

const tr = selectedProject.data.translations?.[locale];
const featuredProject = {
    title: tr?.title ?? selectedProject.data.title,
    type: tr?.role ?? selectedProject.data.role ?? 'Project',
    isFeatured: selectedProject.data.featured || false,
    description: tr?.shortDescription ?? selectedProject.data.shortDescription,
    technologies: selectedProject.data.techStack?.slice(0, 4) ?? [],
    link: localizedHref(`/projects/${selectedProject.id}`, locale),
    previewImage: selectedProject.data.heroImage,
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
    <BaseHead title={t.meta.home.title} description={t.meta.home.description} includePerson />
</head>
<body>
<SkipLink />
<Scanlines />
<Header />

<main id="main" tabindex="-1" class="home-main">
    <Hero />

    <FeaturedProject project={featuredProject} />

    <FullWidth>
        <Skills skills={skills} />
    </FullWidth>

    <CallToAction />
</main>

<Footer />
</body>
</html>

<style>
    .home-main {
        width: 100%;
        max-width: 80rem;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
    }

    @media (min-width: 640px) {
        .home-main { padding: 3rem 1.5rem 4rem; }
    }
</style>
