---
import AboutLayout from '../../layouts/AboutLayout.astro';
import AboutSkills from '../../components/AboutSkills.astro';
import Intro from '../../components/about/Intro.astro';
import WhatIDo from '../../components/about/WhatIDo.astro';
import Strengths from '../../components/about/Strengths.astro';
import Motivation from '../../components/about/Motivation.astro';
import SectionCard from '../../components/SectionCard.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);

const skills = {
    backend: ['C#', '.NET', 'Azure', 'Java', 'PostgreSQL', 'Docker'],
    frontend: ['HTML5', 'CSS3', 'JavaScript', 'TypeScript', 'React', 'Vue.js', 'Tailwind CSS', 'SCSS', 'Astro'],
    tools: ['Git', 'JavaFX', 'Cisco', 'Raspberry Pi'],
};
---

<AboutLayout title={t.meta.about.title} description={t.meta.about.description}>
    <SectionCard>
        <Intro />
    </SectionCard>

    <WhatIDo />
    <Strengths />

    <SectionCard>
        <Motivation />
    </SectionCard>

    <AboutSkills skills={skills} />
</AboutLayout>
