---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import Scanlines from '../components/Scanlines.astro';
import TerminalFrame from '../components/TerminalFrame.astro';
import { useTranslations, getLocale, localizedHref } from '../i18n';
import { SITE_AUTHOR, SITE_URL } from '../consts';

const {
    id,
    title,
    shortDescription,
    description,
    pubDate,
    updatedDate,
    heroImage,
    techStack,
    repoUrl,
    liveUrl,
    role,
    features,
    year,
    translations,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);
const locale = getLocale(Astro.currentLocale);
const lang = locale === 'nl' ? 'nl' : 'en';

// translation fallback
const tr = translations?.[locale];
const tTitle = tr?.title ?? title;
const tShort = tr?.shortDescription ?? shortDescription;
const tDescription = tr?.description ?? description ?? shortDescription;
const tRole = tr?.role ?? role;
const tFeatures = tr?.features ?? features;

const breadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.nav.home,     item: `${SITE_URL}${localizedHref('/', locale)}` },
        { '@type': 'ListItem', position: 2, name: t.nav.projects, item: `${SITE_URL}${localizedHref('/projects', locale)}` },
        { '@type': 'ListItem', position: 3, name: tTitle,         item: Astro.url.toString() },
    ],
};

const creativeWork = {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: tTitle,
    description: tShort,
    author: { '@type': 'Person', name: SITE_AUTHOR },
    dateCreated: pubDate ? new Date(pubDate).toISOString() : undefined,
    dateModified: updatedDate ? new Date(updatedDate).toISOString() : undefined,
    keywords: techStack?.join(', '),
    inLanguage: locale === 'nl' ? 'nl-BE' : 'en',
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
    <BaseHead title={`${tTitle} · ${SITE_AUTHOR}`} description={tShort} type="article" image={heroImage} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script type="application/ld+json" set:html={JSON.stringify(creativeWork)} />
</head>

<body>
<SkipLink />
<Scanlines />
<Header />

<main id="main" tabindex="-1" class="project-detail">
    <article>
        <nav class="project-detail__crumbs" aria-label="Breadcrumb">
            <a href={localizedHref('/projects', locale)}>{t.projects.backToProjects}</a>
        </nav>

        <TerminalFrame filename={`projects/${id ?? 'project'}.md`} lang="md">
            {heroImage && (
                <div class="project-detail__hero">
                    <Image
                        src={heroImage}
                        widths={[480, 960, 1440]}
                        sizes="(min-width: 900px) 60vw, 100vw"
                        alt={tTitle}
                        class="project-detail__hero-img"
                        loading="eager"
                    />
                </div>
            )}

            <div class="project-detail__meta">
                <FormattedDate date={pubDate} />
                {year && <span class="chip-mono">{year}</span>}
                {updatedDate && (
                    <span class="project-detail__updated">
                        {t.projects.updated}: <FormattedDate date={updatedDate} />
                    </span>
                )}
            </div>

            <h1 class="project-detail__title">{tTitle}</h1>
            <p class="project-detail__lede">{tShort}</p>
        </TerminalFrame>

        <div class="project-detail__grid">
            <div class="project-detail__main">
                <section class="project-detail__content">
                    <div class="prose">
                        <slot />
                    </div>
                </section>

                {tRole && (
                    <section class="project-detail__panel">
                        <h2><span class="hash"># </span>{t.projects.myRole}</h2>
                        <p>{tRole}</p>
                    </section>
                )}

                {tFeatures && tFeatures.length > 0 && (
                    <section class="project-detail__panel">
                        <h2><span class="hash"># </span>{t.projects.keyFeatures}</h2>
                        <ul class="project-detail__features">
                            {tFeatures.map((f: string) => (
                                <li><span class="bullet">▸</span> {f}</li>
                            ))}
                        </ul>
                    </section>
                )}
            </div>

            <aside class="project-detail__sidebar">
                <section class="project-detail__panel">
                    <h3><span class="hash">// </span>links</h3>
                    <div class="project-detail__links">
                        {liveUrl && (
                            <a href={liveUrl} target="_blank" rel="noopener" class="btn-terminal btn-terminal--solid">
                                {t.projects.liveDemo} →
                            </a>
                        )}
                        {repoUrl && (
                            <a href={repoUrl} target="_blank" rel="noopener" class="btn-terminal">
                                {t.projects.repository} →
                            </a>
                        )}
                    </div>
                </section>

                {techStack && techStack.length > 0 && (
                    <section class="project-detail__panel">
                        <h3><span class="hash">// </span>{t.projects.techStack}</h3>
                        <div class="project-detail__chips">
                            {techStack.map((tech: string) => (
                                <span class="chip-mono">{tech}</span>
                            ))}
                        </div>
                    </section>
                )}

                <section class="project-detail__panel">
                    <h3><span class="hash">// </span>info</h3>
                    <dl class="project-detail__dl">
                        <div>
                            <dt>{t.projects.published}</dt>
                            <dd><FormattedDate date={pubDate} /></dd>
                        </div>
                        {techStack && techStack.length > 0 && (
                            <div>
                                <dt>{t.projects.technologies}</dt>
                                <dd>{techStack.length}</dd>
                            </div>
                        )}
                        {tFeatures && tFeatures.length > 0 && (
                            <div>
                                <dt>{t.projects.features}</dt>
                                <dd>{tFeatures.length}</dd>
                            </div>
                        )}
                    </dl>
                </section>
            </aside>
        </div>
    </article>
</main>

<Footer />
</body>
</html>

<style>
    .project-detail {
        max-width: 80rem;
        margin: 2rem auto 4rem;
        padding: 0 1rem;
    }

    .project-detail__crumbs {
        margin-bottom: 1rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
    }

    .project-detail__crumbs a {
        color: var(--color-text-muted);
        text-decoration: none;
    }

    .project-detail__crumbs a:hover {
        color: var(--color-primary);
    }

    .project-detail__hero {
        margin: 0 0 1.25rem 0;
        border-bottom: 1px solid var(--color-border);
    }

    @media (min-width: 640px) {
        .project-detail__hero {
            margin: -1.25rem -1.5rem 1.25rem;
        }
    }

    .project-detail__hero-img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
        aspect-ratio: 2 / 1;
        max-height: 360px;
    }

    @media (max-width: 639px) {
        .project-detail__hero-img { max-height: none; aspect-ratio: 16 / 9; }
    }

    .project-detail__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-bottom: 0.85rem;
    }

    .project-detail__updated {
        font-style: italic;
        color: var(--color-text-faint);
    }

    .project-detail__title {
        font-family: var(--font-mono);
        font-size: clamp(1.4rem, 5vw, 1.85rem);
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.65rem;
    }

    .project-detail__lede {
        font-family: var(--font-body);
        font-size: 1.05rem;
        color: var(--color-text-muted);
        line-height: 1.65;
        margin: 0;
    }

    .project-detail__grid {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @media (min-width: 900px) {
        .project-detail__grid { grid-template-columns: minmax(0, 1fr) 22rem; }
    }

    .project-detail__main { display: flex; flex-direction: column; gap: 1.25rem; }

    .project-detail__sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    @media (min-width: 900px) {
        .project-detail__sidebar {
            position: sticky;
            top: 5rem;
            align-self: start;
        }
    }

    .project-detail__content,
    .project-detail__panel {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 1.25rem 1.5rem;
    }

    .project-detail__panel h2,
    .project-detail__panel h3 {
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.85rem;
    }

    .project-detail__panel h3 { font-size: 0.95rem; }

    .hash { color: var(--color-syntax-comment); font-weight: 400; }

    .project-detail__panel p {
        font-family: var(--font-body);
        color: var(--color-text);
        line-height: 1.65;
        margin: 0;
    }

    .project-detail__features {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .project-detail__features li {
        font-family: var(--font-body);
        color: var(--color-text);
        line-height: 1.55;
    }

    .project-detail__features .bullet {
        color: var(--color-primary);
        margin-right: 0.4rem;
        font-family: var(--font-mono);
    }

    .project-detail__links {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .project-detail__chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .project-detail__dl {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.85rem;
    }

    .project-detail__dl > div {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
        border-bottom: 1px dashed var(--color-border);
    }

    .project-detail__dl > div:last-child { border-bottom: 0; }

    .project-detail__dl dt {
        color: var(--color-text-muted);
        margin: 0;
    }

    .project-detail__dl dd {
        color: var(--color-text);
        font-weight: 600;
        margin: 0;
    }

    @media (max-width: 480px) {
        .project-detail { padding: 0 0.75rem; margin: 1.5rem auto 2.5rem; }
        .project-detail__content,
        .project-detail__panel { padding: 1rem 1.1rem; }
        .project-detail__lede { font-size: 0.98rem; }
        .project-detail__grid { gap: 1.25rem; }
    }
</style>
