---
import { Image } from 'astro:assets';
import TerminalFrame from './TerminalFrame.astro';
import { useTranslations } from '../i18n';

const { project } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<section class="featured" aria-labelledby="featured-title">
    <header class="featured__header">
        <p class="featured__eyebrow">{t.featured.eyebrow}</p>
        <h2 id="featured-title" class="featured__title">{t.featured.title}</h2>
    </header>

    <TerminalFrame filename="featured.json" lang="json" lineNumbers={true}>
        <Fragment slot="lineNumbers">
            {Array.from({ length: 8 }, (_, i) => <div>{i + 1}</div>)}
        </Fragment>

        <div class="featured__grid">
            <div class="featured__copy">
                <div class="featured__line"><span class="json-brace">{'{'}</span></div>
                <div class="featured__line featured__line--indent">
                    <span class="json-key">"title"</span><span class="json-op">:</span>{' '}
                    <span class="json-string">"{project.title}"</span><span class="json-comma">,</span>
                </div>
                {project.type && (
                    <div class="featured__line featured__line--indent">
                        <span class="json-key">"role"</span><span class="json-op">:</span>{' '}
                        <span class="json-string">"{project.type}"</span><span class="json-comma">,</span>
                    </div>
                )}
                <div class="featured__line featured__line--indent">
                    <span class="json-key">"description"</span><span class="json-op">:</span>
                </div>
                <div class="featured__line featured__line--indent2 featured__desc">
                    {project.description}
                </div>
                {project.technologies && project.technologies.length > 0 && (
                    <div class="featured__line featured__line--indent">
                        <span class="json-key">"stack"</span><span class="json-op">:</span>{' '}
                        <span class="json-bracket">[</span>
                        {project.technologies.map((tech: string, idx: number) => (
                            <>
                                <span class="json-string">"{tech}"</span>
                                {idx < project.technologies.length - 1 && <span class="json-comma">, </span>}
                            </>
                        ))}
                        <span class="json-bracket">]</span>
                    </div>
                )}
                <div class="featured__line"><span class="json-brace">{'}'}</span></div>

                <a href={project.link} class="btn-terminal btn-terminal--solid featured__cta">
                    {t.featured.viewProject}<span aria-hidden="true"> →</span>
                </a>
            </div>

            <div class="featured__media">
                {project.previewImage && (
                    <Image
                        src={project.previewImage}
                        alt={`${project.title} preview`}
                        class="featured__img"
                        loading="lazy"
                    />
                )}
            </div>
        </div>
    </TerminalFrame>
</section>

<style>
    .featured { margin-bottom: 4rem; }

    .featured__header { margin-bottom: 1.25rem; text-align: left; }

    .featured__eyebrow {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--color-syntax-comment);
        margin: 0 0 0.4rem;
    }

    .featured__title {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        color: var(--color-text);
        margin: 0;
    }

    .featured__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    @media (min-width: 900px) {
        .featured__grid { grid-template-columns: 1.2fr 1fr; gap: 2rem; }
    }

    .featured__copy {
        font-family: var(--font-mono);
        font-size: 0.92rem;
        line-height: 1.7;
        color: var(--color-text);
    }

    .featured__line { display: block; }
    .featured__line--indent { padding-left: 1.5rem; }
    .featured__line--indent2 { padding-left: 3rem; }

    .featured__desc { color: var(--color-text-muted); font-style: italic; }

    .json-brace   { color: var(--color-syntax-keyword); }
    .json-key     { color: var(--color-syntax-func); }
    .json-string  { color: var(--color-syntax-string); }
    .json-op,
    .json-comma   { color: var(--color-text-muted); }
    .json-bracket { color: var(--color-syntax-keyword); }

    .featured__cta { margin-top: 1.5rem; }

    .featured__media {
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 1px solid var(--color-border);
        background: var(--color-bg);
    }

    .featured__img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }
</style>
