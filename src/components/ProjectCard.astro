---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { getLocale, localizedHref, useTranslations } from '../i18n';

interface Props {
    project: any;
}

const { project } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);

const tr = project.data.translations?.[locale];
const title = tr?.title ?? project.data.title;
const shortDescription = tr?.shortDescription ?? project.data.shortDescription;
const role = tr?.role ?? project.data.role;

const href = localizedHref(`/projects/${project.id}`, locale);
const filename = `${project.id}.md`;
---

<article class="project-card group">
    <a href={href} class="project-card__link" rel="noopener">
        <div class="project-card__head">
            <span class="project-card__filename">~/projects/{filename}</span>
            {role && <span class="project-card__role">{role}</span>}
        </div>

        {project.data.heroImage && (
            <div class="project-card__media">
                <Image
                    src={project.data.heroImage}
                    width={1200}
                    height={600}
                    alt={title}
                    class="project-card__img"
                    loading="lazy"
                />
            </div>
        )}

        <div class="project-card__body">
            <h3 class="project-card__title">{title}</h3>
            <p class="project-card__desc">{shortDescription}</p>

            <div class="project-card__meta">
                {project.data.techStack?.slice(0, 4).map((tech: string) => (
                    <span class="chip-mono">{tech}</span>
                ))}
            </div>

            <div class="project-card__footer">
                <span class="project-card__date">
                    <FormattedDate date={project.data.pubDate} />
                    {project.data.year ? ` · ${project.data.year}` : ''}
                </span>
                <span class="project-card__cta">{t.projects.viewProject}<span aria-hidden="true"> →</span></span>
            </div>
        </div>
    </a>
</article>

<style>
    .project-card { display: block; }

    .project-card__link {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: border-color var(--motion-fast) var(--ease-out),
                    box-shadow var(--motion-fast) var(--ease-out),
                    transform var(--motion-fast) var(--ease-out);
    }

    .project-card__link:hover {
        border-color: var(--color-primary);
        box-shadow: var(--shadow-glow);
        transform: translateY(-2px);
    }

    .project-card__head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 0.9rem;
        background: var(--color-surface-2);
        border-bottom: 1px solid var(--color-border);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }

    .project-card__filename {
        color: var(--color-syntax-string);
        font-weight: 500;
    }

    .project-card__role {
        margin-left: auto;
        color: var(--color-text-faint);
    }

    .project-card__media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg);
    }

    .project-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--motion-slow) var(--ease-out);
    }

    .project-card:hover .project-card__img,
    .project-card__link:hover .project-card__img {
        transform: scale(1.03);
    }

    .project-card__body {
        padding: 1rem 1.1rem 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        flex: 1;
    }

    .project-card__title {
        font-family: var(--font-mono);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0;
    }

    .project-card__desc {
        font-size: 0.9rem;
        color: var(--color-text-muted);
        line-height: 1.55;
        margin: 0;
    }

    .project-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: auto;
    }

    .project-card__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 0.6rem;
        border-top: 1px dashed var(--color-border);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }

    .project-card__date { color: var(--color-text-faint); }

    .project-card__cta {
        color: var(--color-primary);
        font-weight: 500;
    }
</style>
