---
import TerminalFrame from './TerminalFrame.astro';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="cta" aria-labelledby="cta-title">
    <TerminalFrame filename="contact.sh" lang="bash">
        <div class="cta__inner">
            <h2 id="cta-title" class="cta__title">
                <span class="cta__hash"># </span>{t.cta.title}
            </h2>
            <p class="cta__desc">{t.cta.description}</p>
            <div class="cta__actions">
                <a href={t.cta.primaryHref} class="btn-terminal btn-terminal--solid">
                    <span aria-hidden="true">$</span> {t.cta.primary}
                </a>
                <a href={t.cta.secondaryHref} target="_blank" rel="noopener noreferrer" class="btn-terminal">
                    {t.cta.secondary}
                </a>
            </div>
        </div>
    </TerminalFrame>
</section>

<style>
    .cta { margin-top: 2.5rem; }

    .cta__inner {
        max-width: 36rem;
        margin: 0 auto;
        text-align: center;
        padding: 1rem 0.5rem;
    }

    .cta__title {
        font-family: var(--font-mono);
        font-size: 1.45rem;
        color: var(--color-text);
        margin: 0 0 0.75rem;
        line-height: 1.3;
    }

    .cta__hash { color: var(--color-syntax-comment); font-weight: 400; }

    .cta__desc {
        font-family: var(--font-body);
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0 0 1.5rem;
    }

    .cta__actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    @media (min-width: 640px) {
        .cta__title { font-size: 1.65rem; }
        .cta__inner { padding: 1.5rem 1rem; }
    }
</style>
