---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<div class="header-sentinel" aria-hidden="true"></div>

<header id="main-header" class="site-header">
    <div class="site-header__inner">
        <a href="/" class="site-header__brand" aria-label="Mathias Meeus">
            <span class="site-header__prompt">mathias@meeus</span>
            <span class="site-header__sep">:</span>
            <span class="site-header__path">~</span>
            <span class="site-header__cursor" aria-hidden="true">$</span>
        </a>

        <nav class="site-header__nav" aria-label="Primary">
            <HeaderLink href="/" label={t.nav.home} />
            <HeaderLink href="/projects" label={t.nav.projects} />
            <HeaderLink href="/about" label={t.nav.about} />
        </nav>

        <div class="site-header__actions">
            <button
                id="site-menu-toggle"
                type="button"
                class="site-header__menu-toggle"
                aria-expanded="false"
                aria-controls="site-menu-panel"
                aria-label={t.a11y.openMenu}
                title={t.a11y.openMenu}
            >
                <svg class="site-header__menu-icon site-header__menu-icon--open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="4" y1="7" x2="20" y2="7" />
                    <line x1="4" y1="12" x2="20" y2="12" />
                    <line x1="4" y1="17" x2="20" y2="17" />
                </svg>
                <svg class="site-header__menu-icon site-header__menu-icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="6" y1="6" x2="18" y2="18" />
                    <line x1="6" y1="18" x2="18" y2="6" />
                </svg>
            </button>
            <LangSwitcher />
            <ThemeToggle />
        </div>
    </div>

    <div
        id="site-menu-panel"
        class="site-header__menu-panel"
        data-open="false"
        aria-hidden="true"
    >
        <div class="site-header__menu-panel-inner">
            <p class="site-header__menu-comment">// {t.nav.home}, {t.nav.projects}, {t.nav.about}</p>
            <nav class="site-header__menu-nav" aria-label="Mobile primary">
                <HeaderLink href="/" label={t.nav.home} />
                <HeaderLink href="/projects" label={t.nav.projects} />
                <HeaderLink href="/about" label={t.nav.about} />
            </nav>
        </div>
    </div>
</header>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--color-bg) 92%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid transparent;
        transition: border-color var(--motion-base) var(--ease-out),
                    background-color var(--motion-base) var(--ease-out);
    }

    .site-header[data-scrolled="true"] {
        border-bottom-color: var(--color-border);
    }

    .site-header__inner {
        display: flex;
        align-items: center;
        gap: 1rem;
        max-width: 80rem;
        margin: 0 auto;
        padding: 0.65rem 1rem;
    }

    .site-header__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.05rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--color-text-muted);
        padding: 0.3rem 0.5rem;
        border-radius: var(--radius-md);
        transition: color var(--motion-fast) var(--ease-out);
    }

    .site-header__brand:hover { color: var(--color-primary); }

    .site-header__prompt { color: var(--color-primary); }
    .site-header__sep { color: var(--color-text-faint); }
    .site-header__path { color: var(--color-accent); }
    .site-header__cursor {
        color: var(--color-primary);
        margin-left: 0.35rem;
        font-weight: 700;
    }

    .site-header__nav {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        margin: 0 auto;
    }

    .site-header__actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-left: auto;
    }

    .site-header__menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text-muted);
        cursor: pointer;
        transition: color var(--motion-fast) var(--ease-out),
                    border-color var(--motion-fast) var(--ease-out);
    }

    .site-header__menu-toggle:hover {
        color: var(--color-primary);
        border-color: var(--color-primary);
    }

    .site-header__menu-icon {
        width: 1.15rem;
        height: 1.15rem;
    }

    .site-header__menu-icon--close { display: none; }

    .site-header__menu-toggle[aria-expanded="true"] {
        color: var(--color-primary);
        border-color: var(--color-primary);
    }

    .site-header__menu-toggle[aria-expanded="true"] .site-header__menu-icon--open  { display: none; }
    .site-header__menu-toggle[aria-expanded="true"] .site-header__menu-icon--close { display: block; }

    .site-header__menu-panel {
        display: none;
        border-top: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-surface) 96%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        overflow: hidden;
        max-height: 0;
        transition: max-height var(--motion-base) var(--ease-out);
    }

    .site-header__menu-panel[data-open="true"] {
        max-height: 22rem;
    }

    .site-header__menu-panel-inner {
        max-width: 80rem;
        margin: 0 auto;
        padding: 0.75rem 1rem 1rem;
    }

    .site-header__menu-comment {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-syntax-comment);
        margin: 0 0 0.5rem;
        padding: 0 0.25rem;
    }

    .site-header__menu-nav {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .site-header__menu-nav :global(.header-link) {
        width: 100%;
        justify-content: flex-start;
        padding: 0.65rem 0.85rem;
        font-size: 0.95rem;
        min-height: 44px;
    }

    @media (max-width: 640px) {
        .site-header__inner {
            padding: 0.5rem 0.6rem;
            gap: 0.5rem;
        }

        .site-header__nav { display: none; }
        .site-header__menu-toggle { display: inline-flex; }
        .site-header__menu-panel { display: block; }

        .site-header__brand .site-header__path { display: none; }
    }

    @media (max-width: 480px) {
        .site-header__brand .site-header__prompt { display: none; }
        .site-header__brand .site-header__path { display: inline; }
        .site-header__actions { gap: 0.35rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .site-header__menu-panel { transition: none; }
    }
</style>

<script>
    function setupHeaderScrollState() {
        const sentinel = document.querySelector<HTMLElement>('.header-sentinel');
        const header = document.getElementById('main-header');
        if (!sentinel || !header) return;

        const io = new IntersectionObserver(
            ([entry]) => {
                header.setAttribute(
                    'data-scrolled',
                    String(!entry.isIntersecting)
                );
            },
            { rootMargin: '-1px 0px 0px 0px', threshold: [1] }
        );
        io.observe(sentinel);
    }

    function setupMobileMenu() {
        const toggle = document.getElementById('site-menu-toggle');
        const panel  = document.getElementById('site-menu-panel');
        const header = document.getElementById('main-header');
        if (!toggle || !panel || !header) return;
        if (toggle.dataset.bound === 'true') return;
        toggle.dataset.bound = 'true';

        const setOpen = (open: boolean) => {
            toggle.setAttribute('aria-expanded', String(open));
            panel.setAttribute('data-open', String(open));
            panel.setAttribute('aria-hidden', String(!open));
        };

        toggle.addEventListener('click', () => {
            const isOpen = toggle.getAttribute('aria-expanded') === 'true';
            setOpen(!isOpen);
        });

        panel.querySelectorAll('a').forEach((a) => {
            a.addEventListener('click', () => setOpen(false));
        });

        document.addEventListener('click', (e) => {
            if (toggle.getAttribute('aria-expanded') !== 'true') return;
            const target = e.target as Node | null;
            if (target && !header.contains(target)) setOpen(false);
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
                setOpen(false);
                toggle.focus();
            }
        });

        const desktopQuery = window.matchMedia('(min-width: 641px)');
        desktopQuery.addEventListener('change', (e) => {
            if (e.matches) setOpen(false);
        });
    }

    setupHeaderScrollState();
    setupMobileMenu();
    document.addEventListener('astro:page-load', () => {
        setupHeaderScrollState();
        setupMobileMenu();
    });
</script>
