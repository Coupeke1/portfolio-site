---
import { Image } from 'astro:assets';
import profileImage from '../../assets/profile-Mathias.jpg';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
---

<div class="about-intro">
    <figure class="about-intro__media">
        <div class="about-intro__avatar-frame">
            <div class="about-intro__avatar-glow" aria-hidden="true"></div>
            <Image
                src={profileImage}
                alt="Mathias Meeus"
                width={420}
                height={420}
                class="about-intro__avatar"
                loading="eager"
            />
        </div>
        <figcaption class="about-intro__caption">
            <span class="about-intro__caption-comment">//</span>
            profile.jpg
            <span class="about-intro__caption-comment">·</span>
            <span class="about-intro__caption-meta">read_only</span>
        </figcaption>
    </figure>

    <div class="about-intro__copy">
        <h2 class="about-intro__title">
            <span class="about-intro__prompt">$</span> echo "{t.about.introTitle}"
        </h2>
        <p class="about-intro__text">{t.about.introText}</p>
    </div>
</div>

<style>
    .about-intro {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
    }

    @media (min-width: 720px) {
        .about-intro {
            flex-direction: row;
            gap: 2rem;
            align-items: flex-start;
        }
    }

    .about-intro__media {
        flex-shrink: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.55rem;
    }

    .about-intro__avatar-frame {
        position: relative;
        width: 160px;
        height: 160px;
        border-radius: 9999px;
        padding: 3px;
        background: conic-gradient(
            from 0deg,
            var(--color-primary),
            var(--color-accent),
            var(--color-magenta),
            var(--color-primary)
        );
        box-shadow: var(--shadow-glow);
        isolation: isolate;
    }

    @media (min-width: 720px) {
        .about-intro__avatar-frame {
            width: 184px;
            height: 184px;
        }
    }

    .about-intro__avatar-glow {
        position: absolute;
        inset: -8px;
        border-radius: 9999px;
        background: radial-gradient(
            closest-side,
            color-mix(in srgb, var(--color-primary) 25%, transparent),
            transparent 70%
        );
        z-index: -1;
        opacity: 0.7;
        pointer-events: none;
    }

    .about-intro__avatar {
        width: 100%;
        height: 100%;
        border-radius: 9999px;
        object-fit: cover;
        display: block;
        background: var(--color-bg);
        border: 2px solid var(--color-bg);
    }

    .about-intro__caption {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--color-text-muted);
        display: inline-flex;
        gap: 0.4rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
    }

    .about-intro__caption-comment {
        color: var(--color-syntax-comment);
    }

    .about-intro__caption-meta {
        color: var(--color-syntax-keyword);
    }

    .about-intro__copy {
        flex: 1;
        min-width: 0;
    }

    .about-intro__title {
        font-family: var(--font-mono);
        font-size: clamp(1.15rem, 4vw, 1.65rem);
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.85rem;
        line-height: 1.3;
    }

    .about-intro__prompt {
        color: var(--color-primary);
        font-weight: 700;
    }

    .about-intro__text {
        font-family: var(--font-body);
        font-size: 1.05rem;
        color: var(--color-text-muted);
        line-height: 1.65;
        max-width: 42rem;
        margin: 0;
    }

    @media (max-width: 480px) {
        .about-intro__avatar-frame { width: 140px; height: 140px; }
        .about-intro__text { font-size: 0.98rem; line-height: 1.6; }
        .about-intro { gap: 1.25rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-intro__avatar-frame {
            background: var(--color-primary);
        }
    }
</style>
