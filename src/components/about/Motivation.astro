---
import { useTranslations } from '../../i18n';
const t = useTranslations(Astro.currentLocale);
---

<div class="motivation">
    <h3 class="motivation__heading">
        <span class="motivation__hash"># </span>{t.about.motivationTitle}
    </h3>
    <p class="motivation__text">{t.about.motivationText}</p>
</div>

<style>
    .motivation__heading {
        font-family: var(--font-mono);
        font-size: 1.4rem;
        color: var(--color-text);
        margin: 0 0 0.85rem;
    }

    .motivation__hash { color: var(--color-syntax-comment); font-weight: 400; }

    .motivation__text {
        font-family: var(--font-body);
        font-size: 1.05rem;
        color: var(--color-text-muted);
        line-height: 1.65;
        max-width: 48rem;
        margin: 0;
    }

    @media (max-width: 480px) {
        .motivation__heading { font-size: 1.25rem; }
        .motivation__text { font-size: 1rem; line-height: 1.6; }
    }
</style>
