---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);

const icons = [
    'lucide:braces',
    'lucide:cpu',
    'lucide:boxes',
    'lucide:code-2',
    'lucide:cloud',
    'lucide:database',
];
const items = t.about.cards.strengths.map((label, idx) => ({
    label,
    icon: icons[idx] ?? 'lucide:check',
}));
---

<section class="strengths" aria-labelledby="strengths-title">
    <h3 id="strengths-title" class="strengths__heading">
        <span class="strengths__hash"># </span>{t.about.strengthsTitle}
    </h3>

    <div class="strengths__grid">
        {items.map(item => (
            <div class="strengths__item">
                <Icon name={item.icon} aria-hidden="true" />
                <span>{item.label}</span>
            </div>
        ))}
    </div>
</section>

<style>
    .strengths { margin-top: 2.5rem; margin-bottom: 1.5rem; }

    .strengths__heading {
        font-family: var(--font-mono);
        font-size: 1.4rem;
        color: var(--color-text);
        margin: 0 0 1rem;
    }

    .strengths__hash { color: var(--color-syntax-comment); font-weight: 400; }

    .strengths__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    @media (min-width: 640px) {
        .strengths__grid { grid-template-columns: 1fr 1fr; }
    }

    .strengths__item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.75rem 0.95rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-primary);
        border-radius: var(--radius-md);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--color-text);
    }

    .strengths__item svg {
        width: 1.1rem;
        height: 1.1rem;
        color: var(--color-primary);
        flex-shrink: 0;
    }
</style>
