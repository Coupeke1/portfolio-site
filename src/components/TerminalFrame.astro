---
interface Props {
    filename?: string;
    lang?: string;
    lineNumbers?: boolean;
    padless?: boolean;
    class?: string;
}

const {
    filename,
    lang,
    lineNumbers = false,
    padless = false,
    class: className = '',
} = Astro.props;
---

<div class:list={['terminal', className]}>
    <div class="terminal-titlebar">
        <div class="terminal-dots" aria-hidden="true">
            <span class="terminal-dot terminal-dot--red"></span>
            <span class="terminal-dot terminal-dot--yellow"></span>
            <span class="terminal-dot terminal-dot--green"></span>
        </div>
        {filename && (
            <span class="text-[var(--color-text)] font-medium truncate">
                {filename}
            </span>
        )}
        {lang && (
            <span class="ml-auto text-[var(--color-text-faint)] uppercase tracking-wider text-[0.7rem]">
                {lang}
            </span>
        )}
    </div>

    {lineNumbers ? (
        <div class="terminal-lines">
            <div class="terminal-lines__nums" aria-hidden="true">
                <slot name="lineNumbers">{Array.from({ length: 10 }, (_, i) => (
                    <div>{i + 1}</div>
                ))}</slot>
            </div>
            <div class="terminal-lines__body">
                <slot />
            </div>
        </div>
    ) : (
        <div class:list={['terminal-body', padless && 'terminal-body--padless']}>
            <slot />
        </div>
    )}
</div>

<style>
    @media (max-width: 480px) {
        :global(.terminal-body) { padding: 1rem 1.1rem; }
        :global(.terminal-titlebar) { padding: 0.5rem 0.7rem; font-size: 0.72rem; gap: 0.5rem; }
        :global(.terminal-lines__nums) { padding: 1rem 0.5rem 1rem 0.7rem; font-size: 0.75rem; }
        :global(.terminal-lines__body) { padding: 1rem 1.1rem; }
    }
</style>
