---
import {
    SITE_EMAIL,
    SITE_LOCATION,
    SITE_GITHUB,
    SITE_LINKEDIN,
    SITE_INSTAGRAM,
    SITE_AUTHOR,
} from '../consts';
import { useTranslations } from '../i18n';

const today = new Date();
const t = useTranslations(Astro.currentLocale);
---

<footer class="site-footer">
    <div class="site-footer__inner">
        <div class="site-footer__grid">
            <div>
                <h3 class="site-footer__heading">// {SITE_AUTHOR}</h3>
                <p class="site-footer__line">{t.footer.roleLine}</p>
                <p class="site-footer__line">{t.footer.eduLine}</p>
            </div>

            <div>
                <h3 class="site-footer__heading">// {t.footer.contact}</h3>
                <address class="site-footer__address">
                    <p>
                        <span class="site-footer__key">mail:</span>{' '}
                        <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
                    </p>
                    <p>
                        <span class="site-footer__key">loc:</span>{' '}
                        <span>{SITE_LOCATION}</span>
                    </p>
                </address>
            </div>

            <div>
                <h3 class="site-footer__heading">// {t.footer.follow}</h3>
                <div class="site-footer__socials">
                    <a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <a href={SITE_LINKEDIN} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                        </svg>
                    </a>
                    <a href={SITE_INSTAGRAM} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2zm0 1.5A4.25 4.25 0 003.5 7.75v8.5A4.25 4.25 0 007.75 20.5h8.5a4.25 4.25 0 004.25-4.25v-8.5A4.25 4.25 0 0016.25 3.5h-8.5zm4.25 3a5.25 5.25 0 110 10.5 5.25 5.25 0 010-10.5zm0 1.5a3.75 3.75 0 100 7.5 3.75 3.75 0 000-7.5zm5.5-.25a1 1 0 11-2 0 1 1 0 012 0z" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <div class="site-footer__bottom">
            <span class="site-footer__copy">
                <span class="site-footer__comment">// © {today.getFullYear()} {SITE_AUTHOR} · {t.footer.rights}</span>
            </span>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: 4rem;
        border-top: 1px solid var(--color-border);
        background: var(--color-surface);
    }

    .site-footer__inner {
        max-width: 80rem;
        margin: 0 auto;
        padding: 2.5rem 1rem 1.75rem;
    }

    .site-footer__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    @media (min-width: 768px) {
        .site-footer__grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .site-footer__heading {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-syntax-comment);
        margin-bottom: 0.75rem;
        text-transform: lowercase;
        letter-spacing: 0.02em;
    }

    .site-footer__line {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text);
        margin: 0.25rem 0;
    }

    .site-footer__address {
        font-style: normal;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }

    .site-footer__address p { margin: 0.25rem 0; }

    .site-footer__key {
        color: var(--color-syntax-keyword);
    }

    .site-footer__address a {
        color: var(--color-accent);
        text-decoration: none;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .site-footer__address a:hover { text-decoration: underline; }

    .site-footer__socials {
        display: flex;
        gap: 0.75rem;
    }

    .site-footer__socials a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        background: var(--color-bg);
        color: var(--color-text-muted);
        transition: color var(--motion-fast) var(--ease-out),
                    border-color var(--motion-fast) var(--ease-out);
    }

    .site-footer__socials a:hover {
        color: var(--color-primary);
        border-color: var(--color-primary);
    }

    .site-footer__bottom {
        padding-top: 1.25rem;
        border-top: 1px dashed var(--color-border);
        text-align: center;
    }

    .site-footer__copy {
        font-family: var(--font-mono);
        font-size: 0.8rem;
    }

    .site-footer__comment { color: var(--color-syntax-comment); }

    @media (max-width: 767px) {
        .site-footer__inner {
            padding: 2rem 1rem 1.25rem;
        }
    }

    @media (max-width: 479px) {
        .site-footer__inner {
            padding: 1.75rem 0.85rem 1.25rem;
        }

        .site-footer__heading {
            margin-bottom: 0.5rem;
        }

        .site-footer__socials {
            gap: 1rem;
            flex-wrap: wrap;
        }

        .site-footer__socials a {
            width: 2.75rem;
            height: 2.75rem;
        }
    }
</style>
