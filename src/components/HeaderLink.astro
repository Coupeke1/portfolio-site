---
import type { HTMLAttributes } from 'astro/types';
import { getLocale, localizedHref } from '../i18n';

type Props = HTMLAttributes<'a'> & { href: string; label: string };

const { href, label, class: className, ...props } = Astro.props as Props;

const locale = getLocale(Astro.currentLocale);

const cleanHref = href.replace(/^\/en(\/|$)/, '/');
const finalHref = localizedHref(cleanHref === '' ? '/' : cleanHref, locale);

const rawPath = Astro.url.pathname.replace(/^\/en\/?/, '/');
const normalized = rawPath === '' ? '/' : rawPath;
const subpath = normalized.match(/[^\/]+/g);
const isActive = cleanHref === normalized || cleanHref === '/' + (subpath?.[0] || '');
---

<a
    href={finalHref}
    aria-current={isActive ? 'page' : undefined}
    data-active={isActive}
    class:list={['header-link', className]}
    {...props}
>
    <span class="header-link__prefix" aria-hidden="true">{isActive ? '●' : '○'}</span>
    <span class="header-link__label">{label}</span>
    <slot />
</a>

<style>
    .header-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.85rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        border-radius: var(--radius-md);
        transition: color var(--motion-fast) var(--ease-out),
                    background-color var(--motion-fast) var(--ease-out);
    }

    .header-link:hover {
        color: var(--color-primary);
        background: var(--color-surface);
    }

    .header-link[data-active="true"] {
        color: var(--color-primary);
        background: var(--color-surface);
    }

    .header-link__prefix {
        color: var(--color-primary);
        font-size: 0.65rem;
        line-height: 1;
    }

    .header-link[data-active="false"] .header-link__prefix {
        color: var(--color-text-faint);
    }

    @media (pointer: coarse) {
        .header-link {
            min-height: 44px;
            padding: 0.5rem 0.85rem;
        }
    }
</style>
