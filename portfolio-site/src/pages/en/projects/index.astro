---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import SkipLink from '../../../components/SkipLink.astro';
import Scanlines from '../../../components/Scanlines.astro';
import TerminalFrame from '../../../components/TerminalFrame.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { useTranslations, getLocale } from '../../../i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const lang = locale === 'nl' ? 'nl' : 'en';

const projects = (await getCollection('projects')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
    <BaseHead title={t.meta.projects.title} description={t.meta.projects.description} />
</head>

<body>
<SkipLink />
<Scanlines />
<Header />

<main id="main" tabindex="-1" class="projects-main">
    <header class="projects-main__intro">
        <TerminalFrame filename="projects/" lang="ls">
            <div class="projects-main__prompt">
                <span class="projects-main__user">mathias@meeus</span><span class="projects-main__sep">:</span><span class="projects-main__path">~/projects</span><span class="projects-main__cursor">$</span> ls -la
            </div>
            <h1 class="projects-main__title">{t.projects.title}</h1>
            <p class="projects-main__lede">{t.projects.intro}</p>
            <p class="projects-main__count">
                <span class="comment">// {projects.length} projects_found</span>
            </p>
        </TerminalFrame>
    </header>

    <section class="projects-main__grid" aria-label={t.projects.title}>
        {projects.map(project => <ProjectCard project={project} />)}
    </section>
</main>

<Footer />
</body>
</html>

<style>
    .projects-main {
        max-width: 80rem;
        margin: 2rem auto 4rem;
        padding: 0 1rem;
    }

    .projects-main__intro { margin-bottom: 2rem; }

    .projects-main__prompt {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .projects-main__user { color: var(--color-primary); font-weight: 600; }
    .projects-main__sep { color: var(--color-text-faint); }
    .projects-main__path { color: var(--color-accent); }
    .projects-main__cursor { color: var(--color-primary); margin: 0 0.5rem; font-weight: 700; }

    .projects-main__title {
        font-family: var(--font-mono);
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.5rem;
    }

    .projects-main__lede {
        font-family: var(--font-body);
        font-size: 1rem;
        color: var(--color-text-muted);
        line-height: 1.55;
        margin: 0 0 0.85rem;
        max-width: 42rem;
    }

    .projects-main__count {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        margin: 0;
    }

    .projects-main__count .comment { color: var(--color-syntax-comment); }

    .projects-main__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @media (min-width: 640px) {
        .projects-main { padding: 0 1.5rem; }
        .projects-main__grid { grid-template-columns: 1fr 1fr; }
    }

    @media (min-width: 1024px) {
        .projects-main__grid { grid-template-columns: 1fr 1fr 1fr; }
    }
</style>
