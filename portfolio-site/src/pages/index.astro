---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="nl">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body style="background: var(--color-bg); color: var(--color-text);">
<Header />
<main class="homepage-main w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
	<section class="text-center mb-12 sm:mb-16">
		<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3 sm:mb-4 leading-tight" style="color: var(--color-text);">
			Mathias Meeus
		</h1>
		<p class="text-lg sm:text-xl md:text-2xl mb-4 sm:mb-6" style="color: var(--color-primary);">
			Full-Stack Developer in Opleiding
		</p>
		<p class="text-base sm:text-lg max-w-2xl mx-auto mb-6 sm:mb-8 leading-relaxed px-2" style="color: var(--color-text-muted);">
			Bachelor Toegepaste Informatica student aan Karel de Grote Hogeschool met expertise in
			moderne webtechnologieën en een sterke focus op kwaliteit en innovatie.
		</p>
		<div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center px-4">
			<a href="/projects"
			   class="inline-block px-6 py-3 rounded-lg font-semibold transition-all duration-200 hover:scale-105 text-center"
			   style="background: var(--color-primary); color: white;">
				Portfolio Bekijken
			</a>
			<a href="/about"
			   class="inline-block px-6 py-3 rounded-lg font-semibold border-2 transition-all duration-200 hover:scale-105 text-center"
			   style="border-color: var(--color-primary); color: var(--color-primary); background: transparent;"
			   onmouseover="this.style.background='var(--color-primary)'; this.style.color='white';"
			   onmouseout="this.style.background='transparent'; this.style.color='var(--color-primary)';">
				Meer Informatie
			</a>
		</div>
	</section>

	<section class="mb-12 sm:mb-16">
		<h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-6 sm:mb-8 text-center" style="color: var(--color-text);">
			Uitgelicht Project
		</h2>
		<div class="rounded-xl p-4 sm:p-6 md:p-8 shadow-lg" style="background: var(--color-surface); border: 1px solid var(--color-border);">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 items-center">
				<div class="order-2 lg:order-1">
					<h3 class="text-xl sm:text-2xl font-bold mb-3 sm:mb-4" style="color: var(--color-primary);">
						Burgerpanel WebApp
					</h3>
					<p class="mb-4 text-sm sm:text-base leading-relaxed" style="color: var(--color-text);">
						Volledig functionele webapplicatie ontwikkeld met C# en .NET Framework.
						Demonstreert expertise in full-stack development, database architectuur
						en gebruikersinterface design.
					</p>
					<div class="flex flex-wrap gap-2 mb-4 sm:mb-6">
						<span class="px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm" style="background: var(--color-primary-100); color: var(--color-primary);">C#</span>
						<span class="px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm" style="background: var(--color-primary-100); color: var(--color-primary);">.NET</span>
						<span class="px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm" style="background: var(--color-primary-100); color: var(--color-primary);">PostgreSQL</span>
					</div>
					<a href="/projects"
					   class="inline-flex items-center font-semibold hover:underline text-sm sm:text-base"
					   style="color: var(--color-primary);">
						Project Details →
					</a>
				</div>
				<div class="rounded-lg p-6 sm:p-8 text-center order-1 lg:order-2 border-2 border-dashed" style="background: var(--color-bg); border-color: var(--color-border);">
					<h4 class="text-lg sm:text-xl font-semibold mb-2" style="color: var(--color-text);">Burgerpanel System</h4>
					<p class="text-xs sm:text-sm" style="color: var(--color-text-muted);">Full-Stack Web Application</p>
				</div>
			</div>
		</div>
	</section>

	<section class="mb-12 sm:mb-16">
		<h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-6 sm:mb-8 text-center" style="color: var(--color-text);">
			Technische Competenties
		</h2>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
			<div class="p-4 sm:p-6 rounded-lg" style="background: var(--color-surface); border: 1px solid var(--color-border);">
				<h3 class="text-base sm:text-lg font-bold mb-3 sm:mb-4" style="color: var(--color-primary);">Backend Development</h3>
				<div class="space-y-2">
					<div class="flex flex-wrap gap-2">
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">C#</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">.NET</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Java</span>
					</div>
					<div class="flex flex-wrap gap-2">
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">PostgreSQL</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Oracle</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Docker</span>
					</div>
				</div>
			</div>
			<div class="p-4 sm:p-6 rounded-lg" style="background: var(--color-surface); border: 1px solid var(--color-border);">
				<h3 class="text-base sm:text-lg font-bold mb-3 sm:mb-4" style="color: var(--color-primary);">Frontend Development</h3>
				<div class="space-y-2">
					<div class="flex flex-wrap gap-2">
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">HTML5</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">CSS3</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">JavaScript</span>
					</div>
					<div class="flex flex-wrap gap-2">
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">TypeScript</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Vue.js</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Tailwind</span>
					</div>
				</div>
			</div>
			<div class="p-4 sm:p-6 rounded-lg" style="background: var(--color-surface); border: 1px solid var(--color-border);">
				<h3 class="text-base sm:text-lg font-bold mb-3 sm:mb-4" style="color: var(--color-primary);">Tools & Platforms</h3>
				<div class="space-y-2">
					<div class="flex flex-wrap gap-2">
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Astro</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">JavaFX</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Git</span>
					</div>
					<div class="flex flex-wrap gap-2">
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Cisco</span>
						<span class="px-2 py-1 rounded text-xs" style="background: var(--color-primary-100); color: var(--color-primary);">Raspberry Pi</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="mb-12 sm:mb-16">
		<div class="text-center p-6 sm:p-8 rounded-xl" style="background: var(--color-surface); border: 1px solid var(--color-border);">
			<h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-4 sm:mb-6" style="color: var(--color-text);">
				Mijn Toegevoegde Waarde
			</h2>
			<p class="text-sm sm:text-base lg:text-lg max-w-3xl mx-auto mb-6 sm:mb-8 leading-relaxed px-2" style="color: var(--color-text-muted);">
				Gedreven student met een sterke leermotivatie en pragmatische aanpak.
				Gespecialiseerd in het ontwikkelen van schaalbare applicaties met focus op
				code kwaliteit, onderhoudbaarheid en gebruiksvriendelijkheid.
			</p>
			<a href="/about"
			   class="inline-block px-6 py-3 rounded-lg font-semibold border-2 transition-all duration-200 hover:scale-105"
			   style="border-color: var(--color-primary); color: var(--color-primary); background: transparent;"
			   onmouseover="this.style.background='var(--color-primary)'; this.style.color='white';"
			   onmouseout="this.style.background='transparent'; this.style.color='var(--color-primary)';">
				Professioneel Profiel
			</a>
		</div>
	</section>

	<section class="text-center">
		<h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-4 sm:mb-6" style="color: var(--color-text);">
			Contact & Samenwerking
		</h2>
		<p class="text-sm sm:text-base lg:text-lg mb-6 sm:mb-8 max-w-2xl mx-auto leading-relaxed px-2" style="color: var(--color-text-muted);">
			Open voor stage-opportuniteiten en junior development posities.
			Geïnteresseerd in innovatieve projecten en professionele groei binnen een dynamisch team.
		</p>
		<div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center px-4">
			<a href="mailto:mathiasmeeus2@gmail.com"
			   class="inline-block px-6 py-3 rounded-lg font-semibold transition-all duration-200 hover:scale-105 text-center"
			   style="background: var(--color-primary); color: white;">
				Contact Opnemen
			</a>
			<a href="https://github.com/Coupeke1"
			   target="_blank"
			   rel="noopener noreferrer"
			   class="inline-block px-6 py-3 rounded-lg font-semibold border-2 transition-all duration-200 hover:scale-105 text-center"
			   style="border-color: var(--color-primary); color: var(--color-primary); background: transparent;"
			   onmouseover="this.style.background='var(--color-primary)'; this.style.color='white';"
			   onmouseout="this.style.background='transparent'; this.style.color='var(--color-primary)';">
				GitHub Repository
			</a>
		</div>
	</section>
</main>
<Footer />
</body>
</html>