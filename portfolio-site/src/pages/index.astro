---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import Skills from '../components/Skills.astro';
import CallToAction from '../components/CallToAction.astro';
import {SITE_DESCRIPTION, SITE_TITLE} from '../consts';
import FullWidth from "../components/FullWidth.astro";
import {getCollection} from 'astro:content';


const skills = {
    backend: ['C#', '.NET', 'Java', 'PostgreSQL', 'Docker'],
    frontend: ['HTML5', 'CSS3', 'JavaScript', 'TypeScript', 'React', 'Vue.js', 'Tailwind CSS', 'SCSS', 'Astro'],
    tools: ['Git', 'JavaFX', 'Cisco', 'Raspberry Pi']
};

const heroData = {
    title: 'Mathias Meeus',
    subtitle: 'Full-Stack Developer in Opleiding',
    description: 'Bachelor Toegepaste Informatica student aan Karel de Grote Hogeschool met expertise in moderne webtechnologieën en een sterke focus op kwaliteit en innovatie.',
    primaryButton: {
        text: 'Portfolio Bekijken',
        href: '/projects'
    },
    secondaryButton: {
        text: 'Meer Informatie',
        href: '/about'
    }
};

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter(p => p.data.featured === true);
const projectsToChooseFrom = featuredProjects.length > 0 ? featuredProjects : allProjects;
const selectedProject = projectsToChooseFrom[Math.floor(Math.random() * projectsToChooseFrom.length)];

const featuredProject = {
    title: selectedProject.data.title,
    type: selectedProject.data.role || 'Project',
    isFeatured: selectedProject.data.featured || false,
    description: selectedProject.data.shortDescription,
    technologies: selectedProject.data.techStack?.slice(0, 3) ?? [],
    link: `/projects/${selectedProject.id}`,
    previewTitle: selectedProject.data.title,
    previewSubtitle: selectedProject.data.role || '',
    previewImage: selectedProject.data.heroImage
};

const ctaData = {
    title: 'Interesse in een samenwerking?',
    description: 'Ik sta open voor stage-opportuniteiten en junior development posities. Laten we in contact komen en kijken hoe we samen kunnen werken!',
    primaryButton: {
        text: 'Neem contact op',
        href: 'mailto:mathiasmeeus2@gmail.com'
    },
    secondaryButton: {
        text: 'GitHub Repository',
        href: 'https://github.com/Coupeke1'
    }
};
---

<html lang="nl" class="scroll-smooth">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/>
</head>
<body class="bg-[var(--color-bg)] text-[var(--color-text)] transition-colors duration-200">
<Header/>

<main class="homepage-main w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Hero Section -->
    <Hero
            title={heroData.title}
            subtitle={heroData.subtitle}
            description={heroData.description}
            primaryButton={heroData.primaryButton}
            secondaryButton={heroData.secondaryButton}
    />

    <!-- Featured Project -->
    <FeaturedProject project={featuredProject}/>

    <!-- Technical Skills -->
    <FullWidth>
        <Skills skills={skills}/>
    </FullWidth>

    <!-- Call to Action -->
    <CallToAction
            title={ctaData.title}
            description={ctaData.description}
            primaryButton={ctaData.primaryButton}
            secondaryButton={ctaData.secondaryButton}
    />
</main>

<Footer/>
</body>
</html>
