---
import { useTranslations } from '../../i18n';
const t = useTranslations(Astro.currentLocale);
---

<div class="about-intro">
    <h2 class="about-intro__title">
        <span class="about-intro__prompt">$</span> echo "{t.about.introTitle}"
    </h2>
    <p class="about-intro__text">{t.about.introText}</p>
</div>

<style>
    .about-intro__title {
        font-family: var(--font-mono);
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.85rem;
    }

    .about-intro__prompt {
        color: var(--color-primary);
        font-weight: 700;
    }

    .about-intro__text {
        font-family: var(--font-body);
        font-size: 1.05rem;
        color: var(--color-text-muted);
        line-height: 1.65;
        max-width: 48rem;
        margin: 0;
    }

    @media (min-width: 640px) {
        .about-intro__title { font-size: 1.65rem; }
    }
</style>
