---
import {Icon} from "astro-icon/components";
---

<div class="space-y-4 mb-8">
    <h3 class="text-2xl font-semibold text-[var(--color-text)]">Waar ik sterk in ben</h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <div class="flex items-center gap-3 p-4 rounded-xl bg-[var(--color-primary-100)] border border-[var(--color-border)] shadow-sm">
            <Icon name="lucide:cpu" class="w-6 h-6 text-[var(--color-primary)]"/>
            <span class="text-[var(--color-text)]">Software-architectuur & DDD</span>
        </div>

        <div class="flex items-center gap-3 p-4 rounded-xl bg-[var(--color-primary-100)] border border-[var(--color-border)] shadow-sm">
            <Icon name="lucide:boxes" class="w-6 h-6 text-[var(--color-primary)]"/>
            <span class="text-[var(--color-text)]">Microservices & messaging</span>
        </div>

        <div class="flex items-center gap-3 p-4 rounded-xl bg-[var(--color-primary-100)] border border-[var(--color-border)] shadow-sm">
            <Icon name="lucide:code-2" class="w-6 h-6 text-[var(--color-primary)]"/>
            <span class="text-[var(--color-text)]">Java, Kotlin, TypeScript</span>
        </div>

        <div class="flex items-center gap-3 p-4 rounded-xl bg-[var(--color-primary-100)] border border-[var(--color-border)] shadow-sm">
            <Icon name="lucide:database" class="w-6 h-6 text-[var(--color-primary)]"/>
            <span class="text-[var(--color-text)]">Spark, Neo4j, SQL</span>
        </div>

    </div>
</div>
