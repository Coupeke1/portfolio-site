---
import { Icon } from 'astro-icon/components';
import TerminalFrame from '../TerminalFrame.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);

const cards = [
    { key: 'architecture', icon: 'lucide:boxes', filename: 'architecture.md' },
    { key: 'framework',    icon: 'lucide:layers', filename: 'framework.md' },
    { key: 'data',         icon: 'lucide:database', filename: 'data.md' },
    { key: 'frontend',     icon: 'lucide:monitor', filename: 'frontend.md' },
] as const;
---

<section class="what-i-do" aria-labelledby="what-i-do-title">
    <h3 id="what-i-do-title" class="what-i-do__heading">
        <span class="what-i-do__hash"># </span>{t.about.whatIDoTitle}
    </h3>

    <div class="what-i-do__grid">
        {cards.map(card => {
            const content = t.about.cards[card.key];
            return (
                <TerminalFrame filename={card.filename} lang="md">
                    <div class="what-i-do__card">
                        <div class="what-i-do__card-head">
                            <Icon name={card.icon} aria-hidden="true" />
                            <h4>{content.title}</h4>
                        </div>
                        <ul class="what-i-do__list">
                            {content.items.map(item => <li>{item}</li>)}
                        </ul>
                    </div>
                </TerminalFrame>
            );
        })}
    </div>
</section>

<style>
    .what-i-do { margin-top: 2.5rem; }

    .what-i-do__heading {
        font-family: var(--font-mono);
        font-size: 1.4rem;
        color: var(--color-text);
        margin: 0 0 1.25rem;
    }

    .what-i-do__hash {
        color: var(--color-syntax-comment);
        font-weight: 400;
    }

    .what-i-do__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @media (min-width: 768px) {
        .what-i-do__grid { grid-template-columns: 1fr 1fr; }
    }

    .what-i-do__card { font-family: var(--font-body); }

    .what-i-do__card-head {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.65rem;
        font-family: var(--font-mono);
        color: var(--color-text);
    }

    .what-i-do__card-head svg {
        width: 1.25rem;
        height: 1.25rem;
        color: var(--color-primary);
    }

    .what-i-do__card-head h4 {
        font-family: var(--font-mono);
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
    }

    .what-i-do__list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .what-i-do__list li {
        position: relative;
        padding-left: 1.1rem;
        font-size: 0.92rem;
        color: var(--color-text-muted);
        line-height: 1.55;
    }

    .what-i-do__list li::before {
        content: '>';
        position: absolute;
        left: 0;
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-weight: 700;
    }
</style>
