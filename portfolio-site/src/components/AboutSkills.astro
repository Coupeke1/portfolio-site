---
import { Icon } from "astro-icon/components";
const { skills } = Astro.props;

const skillColors = {
    "Java": "#f80000",              // Oracle Red Brand
    "C#": "#512BD4",                // Microsoft Purple
    ".NET": "#512BD4",
    "Node.js": "#339933",
    "PostgreSQL": "#336791",
    "Docker": "#2496ED",
    "HTML5": "#E34F26",
    "CSS3": "#1572B6",
    "JavaScript": "#F7DF1E",
    "TypeScript": "#3178C6",
    "React": "#61DAFB",
    "Vue.js": "#42b883",
    "Tailwind CSS": "#38BDF8",
    "SCSS": "#CC6699",
    "Git": "#F05032",
    "Astro": "#FF5D01",
    "JavaFX": "#f80000",
    "Cisco": "#1ba0d7",
    "Raspberry Pi": "#C51A4A",
};

const skillIcons = {
    "Java": "simple-icons:oracle",
    "C#": "simple-icons:csharp",
    ".NET": "simple-icons:dotnet",
    "Node.js": "simple-icons:nodedotjs",
    "PostgreSQL": "simple-icons:postgresql",
    "Docker": "simple-icons:docker",
    "HTML5": "simple-icons:html5",
    "CSS3": "simple-icons:css3",
    "JavaScript": "simple-icons:javascript",
    "TypeScript": "simple-icons:typescript",
    "React": "simple-icons:react",
    "Vue.js": "simple-icons:vuedotjs",
    "Tailwind CSS": "simple-icons:tailwindcss",
    "SCSS": "simple-icons:sass",
    "Git": "simple-icons:git",
    "Astro": "simple-icons:astro",
    "JavaFX": "simple-icons:oracle",
    "Cisco": "simple-icons:cisco",
    "Raspberry Pi": "simple-icons:raspberrypi",
};
---
<section class="space-y-10 mt-10">
    <div class="text-center mb-4">
        <h2 class="text-3xl sm:text-4xl font-bold mb-2">Skills & Expertise</h2>
        <p class="text-[var(--color-text-muted)] max-w-xl mx-auto">
            Een overzicht van de technologieën waar ik dagelijks mee werk.
        </p>
        <div class="w-16 h-1 bg-[var(--color-primary)] mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- BACKEND -->
        <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)]">
            <div class="flex items-center gap-3 mb-4">
                <Icon name="lucide:server" class="w-7 h-7 text-[var(--color-primary)]" />
                <h3 class="text-xl font-bold">Backend Development</h3>
            </div>
            <ul class="space-y-2">
                {skills.backend.map(skill => (
                        <li class="flex items-center gap-2 text-[var(--color-text-muted)]">
                            <Icon
                                    name={skillIcons[skill]}
                                    class="w-5 h-5"
                                    style={`color: ${skillColors[skill]};`}
                            />
                            {skill}
                        </li>
                ))}
            </ul>
        </div>

        <!-- FRONTEND -->
        <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)]">
            <div class="flex items-center gap-3 mb-4">
                <Icon name="lucide:monitor" class="w-7 h-7 text-[var(--color-primary)]" />
                <h3 class="text-xl font-bold">Frontend Development</h3>
            </div>
            <ul class="space-y-2">
                {skills.frontend.map(skill => (
                        <li class="flex items-center gap-2 text-[var(--color-text-muted)]">
                            <Icon
                                    name={skillIcons[skill]}
                                    class="w-5 h-5"
                                    style={`color: ${skillColors[skill]};`}
                            />
                            {skill}
                        </li>
                ))}
            </ul>
        </div>

        <!-- TOOLS -->
        <div class="p-6 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)]">
            <div class="flex items-center gap-3 mb-4">
                <Icon name="lucide:settings" class="w-7 h-7 text-[var(--color-primary)]" />
                <h3 class="text-xl font-bold">Tools & Platforms</h3>
            </div>
            <ul class="space-y-2">
                {skills.tools.map(skill => (
                        <li class="flex items-center gap-2 text-[var(--color-text-muted)]">
                            <Icon
                                    name={skillIcons[skill]}
                                    class="w-5 h-5"
                                    style={`color: ${skillColors[skill]};`}
                            />
                            {skill}
                        </li>
                ))}
            </ul>
        </div>

    </div>
</section>
