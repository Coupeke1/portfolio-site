---
import {Icon} from "astro-icon/components";
const {skills} = Astro.props;

const skillColors = {
    "Java": "#f80000",
    "C#": "#512BD4",
    ".NET": "#512BD4",
    "PostgreSQL": "#336791",
    "Docker": "#2496ED",
    "HTML5": "#E34F26",
    "CSS3": "#1572B6",
    "JavaScript": "#F7DF1E",
    "TypeScript": "#3178C6",
    "React": "#61DAFB",
    "Vue.js": "#42b883",
    "Tailwind CSS": "#38BDF8",
    "SCSS": "#CC6699",
    "Git": "#F05032",
    "Astro": "#FF5D01",
    "JavaFX": "#f80000",
    "Cisco": "#1ba0d7",
    "Raspberry Pi": "#C51A4A",
};

const skillIcons = {
    "Java": "simple-icons:oracle",
    "C#": "simple-icons:csharp",
    ".NET": "simple-icons:dotnet",
    "PostgreSQL": "simple-icons:postgresql",
    "Docker": "simple-icons:docker",
    "HTML5": "simple-icons:html5",
    "CSS3": "simple-icons:css3",
    "JavaScript": "simple-icons:javascript",
    "TypeScript": "simple-icons:typescript",
    "React": "simple-icons:react",
    "Vue.js": "simple-icons:vuedotjs",
    "Tailwind CSS": "simple-icons:tailwindcss",
    "SCSS": "simple-icons:sass",
    "Git": "simple-icons:git",
    "Astro": "simple-icons:astro",
    "JavaFX": "simple-icons:oracle",
    "Cisco": "simple-icons:cisco",
    "Raspberry Pi": "simple-icons:raspberrypi",
};
---

<div class="space-y-6">
    <h3 class="text-2xl font-semibold text-[var(--color-text)]">Technische Skills</h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Backend -->
        <div class="p-6 rounded-xl bg-[var(--color-primary-100)] border border-[var(--color-border)] shadow-sm">
            <div class="flex items-center gap-3 mb-4">
                <Icon name="lucide:server" class="w-7 h-7 text-[var(--color-primary)]"/>
                <h4 class="text-xl font-semibold text-[var(--color-text)]">Backend Development</h4>
            </div>

            <ul class="space-y-2">
                {skills.backend.map(skill => (
                        <li class="flex items-center gap-2 text-[var(--color-text-muted)]">
                            <Icon name={skillIcons[skill]} class="w-5 h-5" style={`color: ${skillColors[skill]};`}/>
                            {skill}
                        </li>
                ))}
            </ul>
        </div>

        <!-- Frontend -->
        <div class="p-6 rounded-xl bg-[var(--color-primary-100)] border border-[var(--color-border)] shadow-sm">
            <div class="flex items-center gap-3 mb-4">
                <Icon name="lucide:monitor" class="w-7 h-7 text-[var(--color-primary)]"/>
                <h4 class="text-xl font-semibold text-[var(--color-text)]">Frontend Development</h4>
            </div>

            <ul class="space-y-2">
                {skills.frontend.map(skill => (
                        <li class="flex items-center gap-2 text-[var(--color-text-muted)]">
                            <Icon name={skillIcons[skill]} class="w-5 h-5" style={`color: ${skillColors[skill]};`}/>
                            {skill}
                        </li>
                ))}
            </ul>
        </div>

        <!-- Tools -->
        <div class="p-6 rounded-xl bg-[var(--color-primary-100)] border border-[var(--color-border)] shadow-sm">
            <div class="flex items-center gap-3 mb-4">
                <Icon name="lucide:settings" class="w-7 h-7 text-[var(--color-primary)]"/>
                <h4 class="text-xl font-semibold text-[var(--color-text)]">Tools & Platforms</h4>
            </div>

            <ul class="space-y-2">
                {skills.tools.map(skill => (
                        <li class="flex items-center gap-2 text-[var(--color-text-muted)]">
                            <Icon name={skillIcons[skill]} class="w-5 h-5" style={`color: ${skillColors[skill]};`}/>
                            {skill}
                        </li>
                ))}
            </ul>
        </div>

    </div>
</div>
