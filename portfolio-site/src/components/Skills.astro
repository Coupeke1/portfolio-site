---
import { Icon } from "astro-icon/components";
const { skills } = Astro.props;

const allSkills = [
    ...skills.backend,
    ...skills.frontend,
    ...skills.tools,
];

const skillIcons = {
    "Java": "simple-icons:oracle",
    "C#": "simple-icons:csharp",
    ".NET": "simple-icons:dotnet",
    "Node.js": "simple-icons:nodedotjs",
    "PostgreSQL": "simple-icons:postgresql",
    "Docker": "simple-icons:docker",
    "HTML5": "simple-icons:html5",
    "CSS3": "simple-icons:css3",
    "JavaScript": "simple-icons:javascript",
    "TypeScript": "simple-icons:typescript",
    "React": "simple-icons:react",
    "Vue.js": "simple-icons:vuedotjs",
    "Tailwind CSS": "simple-icons:tailwindcss",
    "SCSS": "simple-icons:sass",
    "Git": "simple-icons:git",
    "Astro": "simple-icons:astro",
    "JavaFX": "simple-icons:oracle",
    "Cisco": "simple-icons:cisco",
    "Raspberry Pi": "simple-icons:raspberrypi",
};
---

<div class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] overflow-hidden py-6 bg-[var(--color-surface)] border-y border-[var(--color-border)]">

    <div class="flex min-w-max animate-marquee whitespace-nowrap">

        {allSkills.map(skill => (
                <div class="flex items-center gap-3 mx-10">
                    <Icon name={skillIcons[skill] ?? "lucide:circle"} class="w-7 h-7 text-[var(--color-primary)]" />
                    <span class="text-[var(--color-text)] text-lg font-medium">{skill}</span>
                </div>
        ))}

        {allSkills.map(skill => (
                <div class="flex items-center gap-3 mx-10">
                    <Icon name={skillIcons[skill] ?? "lucide:circle"} class="w-7 h-7 text-[var(--color-primary)]" />
                    <span class="text-[var(--color-text)] text-lg font-medium">{skill}</span>
                </div>
        ))}

    </div>
</div>

<style>
    @keyframes marquee {
        from {
            transform: translateX(0%);
        }
        to {
            transform: translateX(-100%);
        }
    }

    .animate-marquee {
        animation: marquee 90s linear infinite;
    }
</style>
