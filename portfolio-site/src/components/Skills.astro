---
import { Icon } from "astro-icon/components";

const { skills } = Astro.props;

// Combine all skills into a single flat array
const allSkills = [...skills.backend, ...skills.frontend, ...skills.tools];

// Brand colors
const skillColors = {
    Java: "#f80000",
    "C#": "#512BD4",
    ".NET": "#512BD4",
    Kotlin: "#A97BFF",
    Android: "#3DDC84",
    "Jetpack Compose": "#4285F4",
    Hilt: "#4285F4",
    DataStore: "#00BCD4",
    "Spring Boot": "#6DB33F",
    "Node.js": "#339933",
    PostgreSQL: "#336791",
    Docker: "#2496ED",
    HTML5: "#E34F26",
    CSS3: "#1572B6",
    JavaScript: "#F7DF1E",
    TypeScript: "#3178C6",
    React: "#61DAFB",
    "Vue.js": "#42b883",
    "Tailwind CSS": "#38BDF8",
    SCSS: "#CC6699",
    Git: "#F05032",
    Astro: "#FF5D01",
    JavaFX: "#f80000",
    Cisco: "#1ba0d7",
    "Raspberry Pi": "#C51A4A",
    RabbitMQ: "#FF6600",
    Keycloak: "#3C3C3C",
    Neo4j: "#008CC1",
    MicroPython: "#2B2B2B",
};

const skillIcons = {
    Java: "simple-icons:oracle",
    "C#": "simple-icons:csharp",
    ".NET": "simple-icons:dotnet",
    Kotlin: "simple-icons:kotlin",
    Android: "simple-icons:android",
    "Jetpack Compose": "simple-icons:jetpackcompose",
    Hilt: "simple-icons:dagger",
    DataStore: "simple-icons:google",
    "Spring Boot": "simple-icons:springboot",
    "Node.js": "simple-icons:nodedotjs",
    PostgreSQL: "simple-icons:postgresql",
    Docker: "simple-icons:docker",
    HTML5: "simple-icons:html5",
    CSS3: "simple-icons:css3",
    JavaScript: "simple-icons:javascript",
    TypeScript: "simple-icons:typescript",
    React: "simple-icons:react",
    "Vue.js": "simple-icons:vuedotjs",
    "Tailwind CSS": "simple-icons:tailwindcss",
    SCSS: "simple-icons:sass",
    Git: "simple-icons:git",
    Astro: "simple-icons:astro",
    JavaFX: "simple-icons:oracle",
    Cisco: "simple-icons:cisco",
    "Raspberry Pi": "simple-icons:raspberrypi",
    RabbitMQ: "simple-icons:rabbitmq",
    Keycloak: "simple-icons:keycloak",
    Neo4j: "simple-icons:neo4j",
    MicroPython: "simple-icons:microdotblog",

};

// Slight speed tweak based on number of skills
const speed = Math.max(40, allSkills.length * 3); // seconds
---
<div class="w-full overflow-hidden py-6 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
    <div
            class="marquee-track flex whitespace-nowrap min-w-max"
            style={`animation-duration: ${speed}s;`}
    >
        {/** Render list twice for seamless loop */}
        {[...allSkills, ...allSkills].map(skill => (
                <div class="flex items-center gap-3 mx-10">
                    <Icon
                            name={skillIcons[skill]}
                            class="w-7 h-7"
                            style={`color: ${skillColors[skill]};`}
                    />
                    <span class="text-[var(--color-text)] text-lg font-medium">{skill}</span>
                </div>
        ))}
    </div>
</div>

<style>
    @keyframes marquee {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }

    .marquee-track {
        animation: marquee linear infinite;
    }
</style>
