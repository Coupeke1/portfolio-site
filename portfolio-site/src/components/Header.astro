---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="m-0 px-4 border-b border-[var(--color-border)]" style="background: var(--color-surface); box-shadow: 0 2px 8px rgba(15, 23, 36, 0.05);">
	<nav class="flex items-center justify-between min-h-16">
		<h2 class="m-0 text-base">
			<a href="/" class="no-underline font-bold" style="color: var(--color-primary);">
				{SITE_TITLE}
			</a>
		</h2>
		<div class="flex gap-2">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		box-shadow: 0 2px 8px rgba(15, 23, 36, 0.05);
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--color-primary);
		font-weight: 700;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 4rem;
	}

	nav a {
		padding: 1em 0.5em;
		color: var(--color-text);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	nav a:hover {
		color: var(--color-primary);
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--color-primary);
		color: var(--color-primary);
	}

	.internal-links {
		display: flex;
		gap: 0.5rem;
	}

	.social-links,
	.social-links a {
		display: flex;
		gap: 0.75rem;
	}

	.social-links a {
		color: var(--color-text-muted);
		padding: 0.5em;
		border-radius: 0.375rem;
		transition: all 0.2s ease;
	}

	.social-links a:hover {
		color: var(--color-primary);
		background: var(--color-primary-100);
	}

	.social-links svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}

		.internal-links {
			gap: 0.25rem;
		}

		nav a {
			padding: 1em 0.25em;
		}
	}
</style>