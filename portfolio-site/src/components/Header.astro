---
import {SITE_TITLE} from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="m-0 px-4 border-b border-[var(--color-border)]"
        style="background: var(--color-surface); box-shadow: 0 2px 8px rgba(15, 23, 36, 0.05);">
    <nav class="flex items-center justify-between min-h-16">
        <h2 class="m-0 text-base">
            <a href="/" class="no-underline font-bold" style="color: var(--color-primary);">
                {SITE_TITLE}
            </a>
        </h2>

        <div class="flex gap-2">
            <HeaderLink href="/">Home</HeaderLink>
            <HeaderLink href="/projects">Projects</HeaderLink>
            <HeaderLink href="/about">About</HeaderLink>
        </div>
    </nav>
</header>