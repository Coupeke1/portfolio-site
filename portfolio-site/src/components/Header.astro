---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="sticky top-0 z-50 backdrop-blur-sm bg-opacity-80 dark:bg-opacity-80" style="background: rgba(248, 250, 252, 0.8); border-bottom: 1px solid var(--color-border);">
  <div class="max-w-6xl mx-auto px-4">
    <nav class="flex items-center justify-between h-16">
      <a href="/" class="text-lg font-bold transition-colors duration-200" style="color: var(--color-primary);">
        {SITE_TITLE}
      </a>
      <div class="flex items-center space-x-1">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </div>
    </nav>
  </div>
</header>
<style>
  header {
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .dark header {
    background: rgba(15, 23, 42, 0.8) !important;
    backdrop-filter: blur(8px);
  }

  nav a {
    padding: 0.5rem 1rem;
    font-weight: 500;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
  }

  nav a:hover {
    background-color: var(--color-primary-100);
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    nav {
      padding: 0.5rem 0;
    }
    
    nav a {
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
    }
  }
</style>