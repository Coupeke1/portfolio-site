---
import {SITE_TITLE} from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<script>
    import setupHeader from '../lib/header.ts';

    setupHeader();
</script>

<header
        id="main-header"
        class="sticky top-0 z-50 flex items-center justify-between h-16 mx-auto px-4 w-full max-w-none
         bg-transparent transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] overflow-hidden"
>
    <a href="/" class="text-lg font-bold" style="color: var(--color-primary);">
        {SITE_TITLE}
    </a>

    <nav class="flex items-center space-x-1">
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
    </nav>
</header>
