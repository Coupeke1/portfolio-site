---
import {Image} from 'astro:assets';
const {project} = Astro.props;
import previewImg from '../assets/burgerpanels-preview.png';
---

<section class="mb-16 sm:mb-24">
    <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-2">Mijn Recente Werk</h2>
        <div class="w-16 h-1 bg-[var(--color-primary)] mx-auto rounded-full"></div>
    </div>

    <div class="bg-[var(--color-surface)] rounded-2xl overflow-hidden border border-[var(--color-border)] hover:shadow-xl transition-all duration-[300ms] ease-[cubic-bezier(0.4,0,0.2,1)]">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 p-6 sm:p-8">
            <div class="order-2 lg:order-1">
                <div class="flex items-center mb-4">
                    <span class="inline-block w-3 h-3 rounded-full bg-[var(--color-primary)] mr-2"></span>
                    <span class="text-sm font-medium text-[var(--color-primary)]">{project.type}</span>
                    {project.isFeatured && (
                            <span class="ml-4 px-3 py-1 text-xs sm:text-sm font-medium rounded-full bg-[var(--color-primary-100)] text-[var(--color-primary)] transition-all duration-[300ms] ease-[cubic-bezier(0.4,0,0.2,1)] hover:bg-[var(--color-primary-200)]">
                            Uitgelicht
                        </span>
                    )}
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold mb-4 text-[var(--color-text)]">{project.title}</h3>
                <p class="text-[var(--color-text-muted)] mb-6 leading-relaxed">
                    {project.description}
                </p>
                <div class="flex flex-wrap gap-2 mb-6">
                    {project.technologies.map(tech => (
                            <span class="px-3 py-1 text-xs sm:text-sm rounded-full bg-[var(--color-primary-100)] text-[var(--color-primary)] transition-all duration-[300ms] ease-[cubic-bezier(0.4,0,0.2,1)] hover:bg-[var(--color-primary-200)]">
                            {tech}
                        </span>
                    ))}
                </div>
                <a href={project.link}
                   class="inline-flex items-center text-[var(--color-primary)] font-medium group transition-all duration-[300ms] ease-[cubic-bezier(0.4,0,0.2,1)] hover:text-[var(--color-primary-800)]">
                    Bekijk project
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="h-5 w-5 ml-1 group-hover:translate-x-1 transition-transform duration-200"
                         viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                              clip-rule="evenodd"/>
                    </svg>
                </a>
            </div>
            <div class="order-1 lg:order-2 flex items-center justify-center p-4 bg-[var(--color-bg)] rounded-lg border border-[var(--color-border)]">
                <div class="text-center">
                    <div class="w-full h-48 rounded-lg overflow-hidden border border-[var(--color-border)] mb-4">
                        <Image
                                src={previewImg}
                                alt={project.title + " preview"}
                                class="w-full h-full object-cover"
                                loading="lazy"
                        />
                    </div>
                    <h4 class="text-lg font-semibold text-[var(--color-text)]">{project.previewTitle}</h4>
                    <p class="text-sm text-[var(--color-text-muted)]">{project.previewSubtitle}</p>
                </div>
            </div>
        </div>
    </div>
</section>
