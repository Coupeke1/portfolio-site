---
const {class: className = ""} = Astro.props;
---

<style>
    .full-bleed {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        overflow: hidden;
    }
</style>

<div class={`full-bleed ${className}`}>
    <slot/>
</div>
