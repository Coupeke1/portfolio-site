---
import TerminalFrame from './TerminalFrame.astro';
import TypewriterPrompt from './TypewriterPrompt.astro';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="hero">
    <TerminalFrame filename="whoami.sh" lang="sh">
        <TypewriterPrompt prompt={t.hero.prompt} lines={t.hero.lines} />

        <p class="hero__intro">{t.hero.intro}</p>

        <div class="hero__actions">
            <a href={t.hero.ctaPrimaryHref} class="btn-terminal btn-terminal--solid">
                <span aria-hidden="true">$</span> {t.hero.ctaPrimary}
            </a>
            <a href={t.hero.ctaSecondaryHref} class="btn-terminal">
                <span aria-hidden="true">$</span> {t.hero.ctaSecondary}
            </a>
        </div>
    </TerminalFrame>
</section>

<style>
    .hero { margin-bottom: 3rem; }

    .hero__intro {
        font-family: var(--font-body);
        color: var(--color-text-muted);
        max-width: 38rem;
        margin: 1.5rem 0;
        line-height: 1.65;
        font-size: 1rem;
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    @media (min-width: 640px) {
        .hero { margin-bottom: 4.5rem; }
        .hero__intro { font-size: 1.1rem; }
    }
</style>
