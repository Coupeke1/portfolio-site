---
const { title, description, primaryButton, secondaryButton } = Astro.props;
---

<section class="text-center">
    <div class="bg-gradient-to-r from-[var(--color-primary-50)] to-[var(--color-primary-100)] dark:from-[var(--color-primary-900)] dark:to-[var(--color-primary-800)] rounded-2xl p-8 sm:p-12">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4">{title}</h2>
        <p class="text-lg text-[var(--color-text-muted)] mb-8 max-w-2xl mx-auto">
            {description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={primaryButton.href}
               class="px-8 py-3.5 rounded-xl font-semibold transition-all duration-[300ms] ease-[cubic-bezier(0.4,0,0.2,1)] text-center
                      bg-white text-[#6B46C1] hover:bg-white/90
                      shadow-md hover:shadow-lg hover:shadow-purple-200/50
                      transform hover:-translate-y-0.5 hover:scale-[1.02]
                      border-2 border-transparent hover:border-[#6B46C1]/20
                      relative overflow-hidden group">
                <span class="relative z-10">{primaryButton.text}</span>
                <span class="absolute inset-0 bg-[#6B46C1]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]"></span>
            </a>
            <a href={secondaryButton.href}
               target="_blank"
               rel="noopener noreferrer"
               class="px-8 py-3.5 rounded-xl font-semibold transition-all duration-[300ms] ease-[cubic-bezier(0.4,0,0.2,1)] text-center
                      bg-white text-[#6B46C1] hover:bg-white/90
                      shadow-md hover:shadow-lg hover:shadow-purple-200/50
                      transform hover:-translate-y-0.5 hover:scale-[1.02]
                      border-2 border-transparent hover:border-[#6B46C1]/20
                      relative overflow-hidden group">
                <span class="relative z-10 flex items-center justify-center">
                    {secondaryButton.text}
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </span>
                <span class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]"></span>
            </a>
        </div>
    </div>
</section>
