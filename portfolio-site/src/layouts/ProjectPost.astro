---
import {Image} from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

const {
    title,
    shortDescription,
    description,
    pubDate,
    updatedDate,
    heroImage,
    techStack,
    repoUrl,
    liveUrl,
    role,
    features,
    year
} = Astro.props;
---

<html lang="en">
<head>
    <BaseHead title={title} description={shortDescription ?? description}/>
</head>
<body style="background: var(--color-surface); color: var(--color-text);">
<Header/>
<main class="project-detail-main max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <article>
        <!-- Hero Section -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8" style="border: 1px solid var(--color-border);">
            {heroImage && (
                    <div class="aspect-video overflow-hidden">
                        <Image src={heroImage} width={1200} height={600} alt={title} class="w-full h-full object-cover"/>
                    </div>
            )}
            <div class="p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-3 text-sm mb-4" style="color: var(--color-text-muted);">
                    <FormattedDate date={pubDate}/>
                    {year && <span class="px-2 py-1 rounded-full text-xs font-medium" style="background: var(--color-primary-100); color: var(--color-primary);">{year}</span>}
                    {updatedDate && <span class="italic">Updated: <FormattedDate date={updatedDate}/></span>}
                </div>
                <h1 class="text-3xl sm:text-4xl font-bold mb-4" style="color: var(--color-text);">{title}</h1>
                <div class="max-w-3xl">
                    <p class="text-lg leading-relaxed" style="color: var(--color-text-muted);">{shortDescription}</p>
                </div>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="grid lg:grid-cols-3 gap-8">
            <!-- Left Column - Main Content -->
            <div class="lg:col-span-2 space-y-8">
                <!-- Content Section -->
                <section class="bg-white rounded-xl p-6 sm:p-8 shadow-sm" style="border: 1px solid var(--color-border);">
                    <div class="prose max-w-none" style="color: var(--color-text);">
                        <div class="max-w-2xl">
                            <slot/>
                        </div>
                    </div>
                </section>

                <!-- Description Section -->
                {description && (
                        <section class="bg-white rounded-xl p-6 sm:p-8 shadow-sm" style="border: 1px solid var(--color-border);">
                            <h2 class="text-2xl font-bold mb-4" style="color: var(--color-text);">
                                Over het project
                            </h2>
                            <div class="max-w-2xl">
                                <p class="leading-relaxed" style="color: var(--color-text);">{description}</p>
                            </div>
                        </section>
                )}

                <!-- Role Section -->
                {role && (
                        <section class="bg-white rounded-xl p-6 sm:p-8 shadow-sm" style="border: 1px solid var(--color-border);">
                            <h2 class="text-2xl font-bold mb-4" style="color: var(--color-text);">
                                Mijn rol
                            </h2>
                            <div class="max-w-2xl">
                                <p class="leading-relaxed" style="color: var(--color-text);">{role}</p>
                            </div>
                        </section>
                )}

                <!-- Features Section -->
                {features?.length && (
                        <section class="bg-white rounded-xl p-6 sm:p-8 shadow-sm" style="border: 1px solid var(--color-border);">
                            <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">
                                Belangrijkste features
                            </h2>
                            <div class="max-w-2xl">
                                <div class="grid sm:grid-cols-1 gap-4">
                                    {features.map(feature => (
                                            <div class="flex items-center gap-3 p-4 rounded-lg" style="background: var(--color-surface); border: 1px solid var(--color-border);">
                                                <span class="w-2 h-2 rounded-full flex-shrink-0" style="background: var(--color-accent);"></span>
                                                <span style="color: var(--color-text);">{feature}</span>
                                            </div>
                                    ))}
                                </div>
                            </div>
                        </section>
                )}
            </div>

            <div class="space-y-6">
                <section class="bg-white rounded-xl p-6 shadow-sm" style="border: 1px solid var(--color-border);">
                    <h3 class="text-xl font-bold mb-4" style="color: var(--color-text);">
                        Links
                    </h3>
                    <div class="space-y-3">
                        {liveUrl && (
                                <a href={liveUrl} target="_blank" rel="noopener"
                                   class="flex items-center gap-3 p-3 rounded-lg transition-all hover:transform hover:scale-105 hover:shadow-md"
                                   style="background: var(--color-primary); color: white; text-decoration: none;">
                                    <span class="font-medium">Live Demo</span>
                                </a>
                        )}
                        {repoUrl && (
                                <a href={repoUrl} target="_blank" rel="noopener"
                                   class="flex items-center gap-3 p-3 rounded-lg transition-all hover:transform hover:scale-105 hover:shadow-md"
                                   style="background: var(--color-surface); color: var(--color-text); text-decoration: none; border: 1px solid var(--color-border);">
                                    <span class="font-medium">Repository</span>
                                </a>
                        )}
                    </div>
                </section>

                {techStack?.length && (
                        <section class="bg-white rounded-xl p-6 shadow-sm" style="border: 1px solid var(--color-border);">
                            <h3 class="text-xl font-bold mb-4" style="color: var(--color-text);">
                                Tech Stack
                            </h3>
                            <div class="flex flex-wrap gap-2">
                                {techStack.map(tech => (
                                        <span class="px-3 py-1 rounded-full text-sm font-medium transition-colors hover:opacity-80"
                                              style="background: var(--color-primary-100); color: var(--color-primary); border: 1px solid var(--color-primary);">
                                    {tech}
                                </span>
                                ))}
                            </div>
                        </section>
                )}

                <section class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-6 shadow-sm" style="border: 1px solid var(--color-border);">
                    <h3 class="text-xl font-bold mb-4" style="color: var(--color-text);">
                        Project Info
                    </h3>
                    <div class="space-y-3">
                        <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--color-border);">
                            <span class="text-sm font-medium" style="color: var(--color-text-muted);">Gepubliceerd</span>
                            <span class="text-sm font-bold" style="color: var(--color-text);"><FormattedDate date={pubDate}/></span>
                        </div>
                        {techStack?.length && (
                                <div class="flex justify-between items-center py-2 border-b" style="border-color: var(--color-border);">
                                    <span class="text-sm font-medium" style="color: var(--color-text-muted);">Technologies</span>
                                    <span class="text-sm font-bold" style="color: var(--color-text);">{techStack.length}</span>
                                </div>
                        )}
                        {features?.length && (
                                <div class="flex justify-between items-center py-2">
                                    <span class="text-sm font-medium" style="color: var(--color-text-muted);">Features</span>
                                    <span class="text-sm font-bold" style="color: var(--color-text);">{features.length}</span>
                                </div>
                        )}
                    </div>
                </section>
            </div>
        </div>
    </article>
</main>
<Footer/>
</body>
</html>