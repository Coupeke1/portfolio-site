---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseHead from "../components/BaseHead.astro";

const {title, heroImage, description} = Astro.props;
---

<html lang="en">
<head>
    <BaseHead title={title} description={description ?? "About Mathias Meeus"}/>
</head>

<body class="bg-[var(--color-bg)] text-[var(--color-text)]">
<Header/>

<section class="w-full mb-10 sm:mb-12">
    <div class="max-w-6xl mx-auto rounded-2xl overflow-hidden shadow-lg bg-[var(--color-surface)]"
         style="border: 1px solid var(--color-border);">
        {heroImage && (
                <img src={heroImage.src} alt={title} class="w-full h-[260px] sm:h-[340px] md:h-[380px] object-cover"/>
        )}
    </div>
</section>

<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <slot/>
</main>

<Footer/>
</body>
</html>
